<?xml version="1.0" encoding="utf-8"?>
<!-- Casilla de cada atajo (tema claro): hoja de papel -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#332B2622">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FBF7EE" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#E2D6C3" />
        </shape>
    </item>
</ripple>
