<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget Jesús (racha). Muestra la imagen de la misma tarjeta de racha de
  Inicio («Papel recortado»), que la app dibuja con Flutter
  (WidgetSyncService → TarjetaRachaPapel). Mientras no exista esa imagen
  (widget recién puesto sin abrir la app, o vista previa) se ve una
  versión nativa de la misma tarjeta: papel, racha en terracota y botón.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/jesus_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- La tarjeta de Inicio dibujada a imagen -->
    <ImageView
        android:id="@+id/widget_snapshot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <!-- Respaldo nativo con el mismo estilo -->
    <FrameLayout
        android:id="@+id/widget_fallback"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/widget_sombra"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="4dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/papel_tarjeta"
            android:tint="#2E2B2622" />

        <ImageView
            android:id="@+id/widget_papel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="5dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/papel_tarjeta"
            android:tint="#FBF7EE" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <ImageView
                android:id="@+id/widget_jesus_image"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="35"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="65"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_streak_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lilita_one"
                        android:includeFontPadding="false"
                        android:text="0"
                        android:textColor="#A8452F"
                        android:textSize="40sp" />

                    <TextView
                        android:id="@+id/widget_streak_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginBottom="4dp"
                        android:fontFamily="@font/lilita_one"
                        android:includeFontPadding="false"
                        android:text="días de\nvictoria"
                        android:textColor="#2B2622"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_message"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="2dp"
                    android:layout_weight="1"
                    android:autoSizeMaxTextSize="16sp"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:fontFamily="@font/patrick_hand"
                    android:text="¡Empieza hoy!"
                    android:textColor="#2B2622"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/widget_badge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/papel_pildora"
                    android:backgroundTint="#A8452F"
                    android:ellipsize="end"
                    android:fontFamily="@font/lilita_one"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Registrar día"
                    android:textColor="#FBF7EE"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:layout_width="44dp"
            android:layout_height="15dp"
            android:layout_gravity="top|start"
            android:layout_marginTop="3dp"
            android:importantForAccessibility="no"
            android:rotation="-24"
            android:scaleType="fitXY"
            android:src="@drawable/papel_cinta" />
    </FrameLayout>

</FrameLayout>
