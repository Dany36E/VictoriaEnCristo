<?xml version="1.0" encoding="utf-8"?>
<!-- Widget «Atajos»: abre la Biblia, el Modo Estudio o los Apuntes -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/atajos_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_atajos_bg_light"
    android:orientation="horizontal"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/atajo_biblia"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="4dp"
        android:background="@drawable/widget_atajos_boton_light"
        android:contentDescription="@string/atajo_biblia_desc"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/atajo_biblia" />

        <TextView
            android:id="@+id/atajo_biblia_texto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/atajo_biblia_corto"
            android:textColor="#2B2622"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/atajo_estudio"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="4dp"
        android:background="@drawable/widget_atajos_boton_light"
        android:contentDescription="@string/atajo_estudio_desc"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/atajo_estudio" />

        <TextView
            android:id="@+id/atajo_estudio_texto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/atajo_estudio_corto"
            android:textColor="#2B2622"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/atajo_apuntes"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="4dp"
        android:background="@drawable/widget_atajos_boton_light"
        android:contentDescription="@string/atajo_apuntes_desc"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/atajo_apuntes" />

        <TextView
            android:id="@+id/atajo_apuntes_texto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/atajo_apuntes_corto"
            android:textColor="#2B2622"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
