<?xml version="1.0" encoding="utf-8"?>
<!--
    Excluimos TODOS los datos del backup automático de Android.
    Los datos del usuario viven en Firebase (perfil, progreso, victoryDays,
    notas bíblicas). Backups locales podrían restaurarse en otro dispositivo
    con un usuario distinto y mezclar identidades.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
