<?xml version="1.0" encoding="utf-8"?>
<!-- Accesos al mantener presionado el ícono de la app. La ruta /atajo/<id>
     la resuelve abrirAtajo() en lib/widgets/home/atajos_inicio.dart. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="atajo_biblia"
        android:enabled="true"
        android:icon="@drawable/atajo_biblia"
        android:shortcutShortLabel="@string/atajo_biblia_corto"
        android:shortcutLongLabel="@string/atajo_biblia_largo">
        <intent
            android:action="com.victoriaencristo.app.ATAJO_biblia"
            android:targetPackage="com.victoriaencristo.app"
            android:targetClass="com.example.app_quitar.MainActivity">
            <extra
                android:name="initial_route"
                android:value="/atajo/biblia" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="atajo_estudio"
        android:enabled="true"
        android:icon="@drawable/atajo_estudio"
        android:shortcutShortLabel="@string/atajo_estudio_corto"
        android:shortcutLongLabel="@string/atajo_estudio_largo">
        <intent
            android:action="com.victoriaencristo.app.ATAJO_estudio"
            android:targetPackage="com.victoriaencristo.app"
            android:targetClass="com.example.app_quitar.MainActivity">
            <extra
                android:name="initial_route"
                android:value="/atajo/estudio" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="atajo_apuntes"
        android:enabled="true"
        android:icon="@drawable/atajo_apuntes"
        android:shortcutShortLabel="@string/atajo_apuntes_corto"
        android:shortcutLongLabel="@string/atajo_apuntes_largo">
        <intent
            android:action="com.victoriaencristo.app.ATAJO_apuntes"
            android:targetPackage="com.victoriaencristo.app"
            android:targetClass="com.example.app_quitar.MainActivity">
            <extra
                android:name="initial_route"
                android:value="/atajo/apuntes" />
        </intent>
    </shortcut>
</shortcuts>
