rules_version = '2';

// Cloud Storage rules para Victoria en Cristo.
// Default: deny-all. Sólo paths explícitos se permiten.
service firebase.storage {
  match /b/{bucket}/o {

    // ============================================================
    // Per-user storage
    //   /users/{uid}/{...} — sólo el usuario dueño puede leer y borrar.
    // ============================================================
    match /users/{uid}/{allPaths=**} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
    }

    // Fotos y dibujos de Apuntes. Para que nadie pueda llenar el bucket
    // (y la factura) con archivos cualquiera, sólo se aceptan los nombres
    // que crea la app (a<micros>.jpg, a<micros>.svg, a<micros>_marcas.svg),
    // con su tipo exacto y un tamaño máximo.
    match /users/{uid}/apuntes/{notaId}/{archivo} {
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource != null
                   && notaId.size() <= 64
                   && ((archivo.matches('a[0-9]{10,20}[.]jpg')
                        && request.resource.contentType == 'image/jpeg'
                        && request.resource.size < 3 * 1024 * 1024)
                       || (archivo.matches('a[0-9]{10,20}(_marcas)?[.]svg')
                           && request.resource.contentType == 'image/svg+xml'
                           && request.resource.size < 5 * 1024 * 1024));
    }

    // ============================================================
    // Public assets — sólo lectura, escritura sólo admins.
    // ============================================================
    match /public/{allPaths=**} {
      allow read: if true; // Recursos públicos (covers, audios)
      allow write: if request.auth != null
                   && request.auth.token.admin == true;
    }

    // ============================================================
    // Default deny-all
    // ============================================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
